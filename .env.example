# Server-only Cloudflare Worker runtime variables (do not prefix NEXT_PUBLIC_)
GAS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_API_SECRET=replace-with-long-random-secret

# Initial Super Admin credentials: stored ONLY in Cloudflare production variables/secrets.
SUPER_ADMIN_USERNAME=your-private-admin-username
SUPER_ADMIN_PASSWORD=replace-with-strong-unique-admin-password

# Separate server-to-server bootstrap assertion shared between Cloudflare and Apps Script.
# Cloudflare: GAS_BOOTSTRAP_KEY (Secret)
# Apps Script: BOOTSTRAP_BRIDGE_KEY (Script Property)
GAS_BOOTSTRAP_KEY=replace-with-different-random-64-character-key
